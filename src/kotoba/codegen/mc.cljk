(ns kotoba.codegen.mc
  "Closed allocated machine-code program contract.

  MC retains MIR operands and bounded spill-frame ownership after target
  selection and allocation while making the target encoding choice explicit.
  Backends own the bytes for each encoding; this namespace owns the admitted
  data shape."
  {:kotoba/export [validate! version]}
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                          [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
                                 :form/rd [:record :form/rd [[:form [:ref :form/r]] [:pos :i64]]]}))
  (:require #?(:kotoba [kotoba.form :as form])
            [kotoba.mir :as mir]))

#?(:kotoba
   (defn version [] :i64 3)
   :default
(def version 3))

#?(:kotoba nil :default
(def ^:private selected-keysets
  {:argument #{:mc/op :mc/encoding :mir/dst :mir/index}
   :constant #{:mc/op :mc/encoding :mir/dst :mir/value}
   :data-address #{:mc/op :mc/encoding :mir/dst :mir/content}
   ;; boot-lit: the address of a read-only literal placed in the code image
   ;; (kotoba-gmir ADR-0011). It carries an ENCODING beside its content, which
   ;; is the whole difference from `:data-address` above: that one is always
   ;; UTF-8 and the backend resolves it against a runtime base, and this one is
   ;; UCS-2, a GUID or raw bytes and the backend resolves it against the
   ;; program counter.
   :rodata-address #{:mc/op :mc/encoding :mir/dst :mir/content
                     :mir/rodata-encoding}
   ;; boot-scratch: the address of a FUNCTION in the same module (kotoba-gmir
   ;; ADR-0013). Neither of the two above: a literal's address resolves
   ;; against a pool this contract does not name, and this one resolves
   ;; against a label the module already has -- the same `:mir/function` a
   ;; `:call` carries as `:mir/callee`, which is why the key is a name and not
   ;; a content string. A `:rodata-address` that grew a `:mir/function`, or
   ;; this one that grew a `:mir/content`, is refused: the keysets are exact.
   :function-address #{:mc/op :mc/encoding :mir/dst :mir/function}
   :add #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :subtract #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :multiply #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :multiply-add #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right :mir/addend}
   :multiply-subtract #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right :mir/addend}
   :quotient #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :quotient-constant #{:mc/op :mc/encoding :mir/dst :mir/left :mir/divisor}
   :bit-and #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :bit-or #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :bit-xor #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :shift-left #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :shift-right-signed #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :shift-right-unsigned #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :f64-add #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :f64-subtract #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :f64-multiply #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :f64-divide #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :f64-min #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :f64-max #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :f64-sqrt #{:mc/op :mc/encoding :mir/dst :mir/input}
   :f64-equal #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :f64-less-than #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :f64-less-or-equal #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :f64-greater-than #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :f64-greater-or-equal #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :f64-unordered #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   ;; f32: binary32 (kotoba-lang ADR-kotoba-floating-point-on-native). The same
   ;; operand shapes as the f64 family above -- an f32 is one machine word
   ;; holding its binary32 pattern sign-extended from bit 31, so nothing here
   ;; needs a new field.
   ;;
   ;; No f32-min/f32-max: x86 MINSS/MAXSS return the SECOND operand when either
   ;; input is NaN while AArch64 FMIN and the KIR oracle return the NaN, so the
   ;; f64 pair above already means two things on the two targets. Recorded
   ;; upstream; not inherited here.
   :f32-add #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :f32-subtract #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :f32-multiply #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :f32-divide #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :f32-sqrt #{:mc/op :mc/encoding :mir/dst :mir/input}
   :f32-equal #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :f32-less-than #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :f32-less-or-equal #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :f32-greater-than #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :f32-greater-or-equal #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :f32-unordered #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   ;; Width conversions -- one source in, one value out, like f32-sqrt. Only
   ;; the four on which both ISAs and the oracle agree for every input.
   :f32-to-f64 #{:mc/op :mc/encoding :mir/dst :mir/input}
   :f64-to-f32 #{:mc/op :mc/encoding :mir/dst :mir/input}
   :i64-to-f32 #{:mc/op :mc/encoding :mir/dst :mir/input}
   :i64-to-f64 #{:mc/op :mc/encoding :mir/dst :mir/input}
   :kernel-load-u8 #{:mc/op :mc/encoding :mir/dst :mir/base :mir/length
                     :mir/index :mir/maximum}
   :kernel-store-u8 #{:mc/op :mc/encoding :mir/dst :mir/base :mir/length
                      :mir/index :mir/stored :mir/maximum}
   :kernel-load-u32 #{:mc/op :mc/encoding :mir/dst :mir/base :mir/length
                      :mir/index :mir/maximum}
   :kernel-store-u32 #{:mc/op :mc/encoding :mir/dst :mir/base :mir/length
                       :mir/index :mir/stored :mir/maximum}
   ;; memwidth: the two remaining MMIO transfer widths, and the ADR 0285 slice
   ;; family. Every one carries exactly the fields its u8/u32 sibling does --
   ;; the transfer width is in the encoding name, and for the slice family the
   ;; only other difference is that `:mir/index` counts elements, which the
   ;; backend folds into the addressing mode rather than into a field.
   :kernel-load-u16 #{:mc/op :mc/encoding :mir/dst :mir/base :mir/length
                      :mir/index :mir/maximum}
   :kernel-store-u16 #{:mc/op :mc/encoding :mir/dst :mir/base :mir/length
                       :mir/index :mir/stored :mir/maximum}
   :kernel-load-u64 #{:mc/op :mc/encoding :mir/dst :mir/base :mir/length
                      :mir/index :mir/maximum}
   :kernel-store-u64 #{:mc/op :mc/encoding :mir/dst :mir/base :mir/length
                       :mir/index :mir/stored :mir/maximum}
   :slice-load-u8 #{:mc/op :mc/encoding :mir/dst :mir/base :mir/length
                    :mir/index :mir/maximum}
   :slice-store-u8 #{:mc/op :mc/encoding :mir/dst :mir/base :mir/length
                     :mir/index :mir/stored :mir/maximum}
   :slice-load-u16 #{:mc/op :mc/encoding :mir/dst :mir/base :mir/length
                     :mir/index :mir/maximum}
   :slice-store-u16 #{:mc/op :mc/encoding :mir/dst :mir/base :mir/length
                      :mir/index :mir/stored :mir/maximum}
   :slice-load-u32 #{:mc/op :mc/encoding :mir/dst :mir/base :mir/length
                     :mir/index :mir/maximum}
   :slice-store-u32 #{:mc/op :mc/encoding :mir/dst :mir/base :mir/length
                      :mir/index :mir/stored :mir/maximum}
   :slice-load-u64 #{:mc/op :mc/encoding :mir/dst :mir/base :mir/length
                     :mir/index :mir/maximum}
   :slice-store-u64 #{:mc/op :mc/encoding :mir/dst :mir/base :mir/length
                      :mir/index :mir/stored :mir/maximum}
   ;; memwidth: end
   ;; The lock pair carries the load's fields. No `:mir/stored`: what gets
   ;; written is fixed by the operation -- 1 to acquire, 0 to release -- which
   ;; is the difference between a lock and a compare-exchange.
   :kernel-try-lock-u32 #{:mc/op :mc/encoding :mir/dst :mir/base :mir/length
                          :mir/index :mir/maximum}
   :kernel-unlock-u32 #{:mc/op :mc/encoding :mir/dst :mir/base :mir/length
                        :mir/index :mir/maximum}
   ;; sysops: the general atomic family (kotoba-gmir ADR 0007). Where the lock
   ;; pair above fixes both comparand and replacement, these take the word
   ;; from the guest -- which is what a device descriptor ring needs, and what
   ;; makes them read-modify-writes rather than a mutex.
   ;;
   ;; They carry the store's fields; `:mir/stored` is the addend for the two
   ;; adds and the replacement for the swaps and compare-exchanges. Only the
   ;; compare-exchanges carry `:mir/expected`, and they carry it because a
   ;; guest-supplied comparand is the entire difference between them and the
   ;; lock. `:mir/dst` is the word memory held BEFORE the operation, for all
   ;; six: a compare-exchange that returned only a success flag would force a
   ;; re-read on failure, which is the race it exists to close.
   :kernel-atomic-add-u32 #{:mc/op :mc/encoding :mir/dst :mir/base :mir/length
                            :mir/index :mir/stored :mir/maximum}
   :kernel-atomic-add-u64 #{:mc/op :mc/encoding :mir/dst :mir/base :mir/length
                            :mir/index :mir/stored :mir/maximum}
   :kernel-xchg-u32 #{:mc/op :mc/encoding :mir/dst :mir/base :mir/length
                      :mir/index :mir/stored :mir/maximum}
   :kernel-xchg-u64 #{:mc/op :mc/encoding :mir/dst :mir/base :mir/length
                      :mir/index :mir/stored :mir/maximum}
   :kernel-cmpxchg-u32 #{:mc/op :mc/encoding :mir/dst :mir/base :mir/length
                         :mir/index :mir/expected :mir/stored :mir/maximum}
   :kernel-cmpxchg-u64 #{:mc/op :mc/encoding :mir/dst :mir/base :mir/length
                         :mir/index :mir/expected :mir/stored :mir/maximum}
   ;; sysops: end
   ;; simd: the f32 dot product (kotoba-gmir ADR 0010, kotoba-mir ADR 0015).
   ;; TWO regions, so two bases and two lengths, and `:mir/count` in place of
   ;; the `:mir/index` every other member of this family carries -- it names
   ;; how many elements to fold rather than which one to touch. `:mir/base`
   ;; and `:mir/length` stay the FIRST region's names, so anything reading
   ;; `:mir/base` for a base still finds one.
   ;;
   ;; `:mir/maximum` bounds BOTH lengths, in bytes, while `:mir/count` counts
   ;; elements. x86-64 only: `kotoba.mir` refuses the operation for every
   ;; other target, because the sequence it selects is AVX2 and legacy SSE and
   ;; an AArch64 answer would reduce its lanes in a different order.
   :kernel-dot-f32 #{:mc/op :mc/encoding :mir/dst :mir/base :mir/length
                     :mir/second-base :mir/second-length :mir/count
                     :mir/maximum}
   ;; dequant: the fused dequantize-and-dot family. The same keyset -- two
   ;; regions, a ceiling and a count -- because the operand SHAPE is the
   ;; same; `:mir/count` counts blocks rather than elements, and which it
   ;; counts is the format's business. x86-64 only, for the reason above.
   :kernel-dequant-dot-q8-0 #{:mc/op :mc/encoding :mir/dst :mir/base
                              :mir/length :mir/second-base :mir/second-length
                              :mir/count :mir/maximum}
   :kernel-dequant-dot-q4-k #{:mc/op :mc/encoding :mir/dst :mir/base
                              :mir/length :mir/second-base :mir/second-length
                              :mir/count :mir/maximum}
   :kernel-dequant-dot-q6-k #{:mc/op :mc/encoding :mir/dst :mir/base
                              :mir/length :mir/second-base :mir/second-length
                              :mir/count :mir/maximum}
   ;; dequant-iq: the four codebook formats, same keyset again.
   :kernel-dequant-dot-iq4-xs #{:mc/op :mc/encoding :mir/dst :mir/base
                              :mir/length :mir/second-base :mir/second-length
                              :mir/count :mir/maximum}
   :kernel-dequant-dot-iq2-s #{:mc/op :mc/encoding :mir/dst :mir/base
                             :mir/length :mir/second-base :mir/second-length
                             :mir/count :mir/maximum}
   :kernel-dequant-dot-iq3-xxs #{:mc/op :mc/encoding :mir/dst :mir/base
                               :mir/length :mir/second-base :mir/second-length
                               :mir/count :mir/maximum}
   :kernel-dequant-dot-iq3-s #{:mc/op :mc/encoding :mir/dst :mir/base
                             :mir/length :mir/second-base :mir/second-length
                             :mir/count :mir/maximum}
   :kernel-subregion #{:mc/op :mc/encoding :mir/dst :mir/base :mir/length
                       :mir/offset :mir/size}
   :equal #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :less-than #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :greater-than #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :less-or-equal #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   :greater-or-equal #{:mc/op :mc/encoding :mir/dst :mir/left :mir/right}
   ;; Stack-passed arguments (kotoba-mir, 2026-09-23): argument i >= 5 of a
   ;; call, by index; the encoder turns the index into an offset.
   :incoming-load #{:mc/op :mc/encoding :mir/dst :mir/index}
   :outgoing-argument #{:mc/op :mc/encoding :mir/src :mir/index}
   :incoming-argument-store #{:mc/op :mc/encoding :mir/src :mir/index}
   :spill-load #{:mc/op :mc/encoding :mir/dst :mir/slot}
   :spill-store #{:mc/op :mc/encoding :mir/src :mir/slot}
   :move #{:mc/op :mc/encoding :mir/dst :mir/src}
   :call #{:mc/op :mc/encoding :mir/dst :mir/callee :mir/arguments}
   :tail-call #{:mc/op :mc/encoding :mir/callee :mir/arguments}
   :runtime-call #{:mc/op :mc/encoding :mir/dst :mir/runtime
                   :mir/context-offset :mir/arguments}
   :x86-privileged #{:mc/op :mc/encoding :mir/dst :mir/action :mir/arguments}
   :capability-call #{:mc/op :mc/encoding :mir/dst :mir/capability
                      :mir/kind :mir/context-offset :mir/arguments}
   :return #{:mc/op :mc/encoding :mir/value}}))

#?(:kotoba
   (defn- selected-group-5-0? [op :keyword] :bool
     (or (= op :add) (= op :subtract) (= op :multiply) (= op :quotient) (= op :bit-and) (= op :bit-or) (= op :bit-xor) (= op :shift-left) (= op :shift-right-signed) (= op :shift-right-unsigned) (= op :f64-add) (= op :f64-subtract))))

#?(:kotoba
   (defn- selected-group-5-1? [op :keyword] :bool
     (or (= op :f64-multiply) (= op :f64-divide) (= op :f64-min) (= op :f64-max) (= op :f64-equal) (= op :f64-less-than) (= op :f64-less-or-equal) (= op :f64-greater-than) (= op :f64-greater-or-equal) (= op :f64-unordered) (= op :f32-add) (= op :f32-subtract))))

#?(:kotoba
   (defn- selected-group-5-2? [op :keyword] :bool
     (or (= op :f32-multiply) (= op :f32-divide) (= op :f32-equal) (= op :f32-less-than) (= op :f32-less-or-equal) (= op :f32-greater-than) (= op :f32-greater-or-equal) (= op :f32-unordered) (= op :equal) (= op :less-than) (= op :greater-than) (= op :less-or-equal))))

#?(:kotoba
   (defn- selected-group-5-3? [op :keyword] :bool
     (or (= op :greater-or-equal))))

#?(:kotoba
   ;; The key set a selected instruction of operation OP must have, as EDN text,
   ;; or "" when OP is no operation.
   (defn- selected-keyset-text [op :keyword] :string
     (cond
       (or (= op :argument) (= op :incoming-load)) "#{:mc/encoding :mc/op :mir/dst :mir/index}"
       (or (= op :constant)) "#{:mc/encoding :mc/op :mir/dst :mir/value}"
       (or (= op :data-address)) "#{:mc/encoding :mc/op :mir/content :mir/dst}"
       (or (= op :rodata-address)) "#{:mc/encoding :mc/op :mir/content :mir/dst :mir/rodata-encoding}"
       (or (= op :function-address)) "#{:mc/encoding :mc/op :mir/dst :mir/function}"
       (or (selected-group-5-0? op) (selected-group-5-1? op) (selected-group-5-2? op) (selected-group-5-3? op)) "#{:mc/encoding :mc/op :mir/dst :mir/left :mir/right}"
       (or (= op :multiply-add) (= op :multiply-subtract)) "#{:mc/encoding :mc/op :mir/addend :mir/dst :mir/left :mir/right}"
       (or (= op :quotient-constant)) "#{:mc/encoding :mc/op :mir/divisor :mir/dst :mir/left}"
       (or (= op :f64-sqrt) (= op :f32-sqrt) (= op :f32-to-f64) (= op :f64-to-f32) (= op :i64-to-f32) (= op :i64-to-f64)) "#{:mc/encoding :mc/op :mir/dst :mir/input}"
       (or (= op :kernel-load-u8) (= op :kernel-load-u32) (= op :kernel-load-u16) (= op :kernel-load-u64) (= op :slice-load-u8) (= op :slice-load-u16) (= op :slice-load-u32) (= op :slice-load-u64) (= op :kernel-try-lock-u32) (= op :kernel-unlock-u32)) "#{:mc/encoding :mc/op :mir/base :mir/dst :mir/index :mir/length :mir/maximum}"
       (or (= op :kernel-store-u8) (= op :kernel-store-u32) (= op :kernel-store-u16) (= op :kernel-store-u64) (= op :slice-store-u8) (= op :slice-store-u16) (= op :slice-store-u32) (= op :slice-store-u64) (= op :kernel-atomic-add-u32) (= op :kernel-atomic-add-u64) (= op :kernel-xchg-u32) (= op :kernel-xchg-u64)) "#{:mc/encoding :mc/op :mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/stored}"
       (or (= op :kernel-cmpxchg-u32) (= op :kernel-cmpxchg-u64)) "#{:mc/encoding :mc/op :mir/base :mir/dst :mir/expected :mir/index :mir/length :mir/maximum :mir/stored}"
       (or (= op :kernel-dot-f32) (= op :kernel-dequant-dot-q8-0) (= op :kernel-dequant-dot-q4-k) (= op :kernel-dequant-dot-q6-k) (= op :kernel-dequant-dot-iq4-xs) (= op :kernel-dequant-dot-iq2-s) (= op :kernel-dequant-dot-iq3-xxs) (= op :kernel-dequant-dot-iq3-s)) "#{:mc/encoding :mc/op :mir/base :mir/count :mir/dst :mir/length :mir/maximum :mir/second-base :mir/second-length}"
       (or (= op :kernel-subregion)) "#{:mc/encoding :mc/op :mir/base :mir/dst :mir/length :mir/offset :mir/size}"
       (or (= op :outgoing-argument) (= op :incoming-argument-store)) "#{:mc/encoding :mc/op :mir/index :mir/src}"
       (or (= op :spill-load)) "#{:mc/encoding :mc/op :mir/dst :mir/slot}"
       (or (= op :spill-store)) "#{:mc/encoding :mc/op :mir/slot :mir/src}"
       (or (= op :move)) "#{:mc/encoding :mc/op :mir/dst :mir/src}"
       (or (= op :call)) "#{:mc/encoding :mc/op :mir/arguments :mir/callee :mir/dst}"
       (or (= op :tail-call)) "#{:mc/encoding :mc/op :mir/arguments :mir/callee}"
       (or (= op :runtime-call)) "#{:mc/encoding :mc/op :mir/arguments :mir/context-offset :mir/dst :mir/runtime}"
       (or (= op :x86-privileged)) "#{:mc/encoding :mc/op :mir/action :mir/arguments :mir/dst}"
       (or (= op :capability-call)) "#{:mc/encoding :mc/op :mir/arguments :mir/capability :mir/context-offset :mir/dst :mir/kind}"
       (or (= op :return)) "#{:mc/encoding :mc/op :mir/value}"
       :else "")))

;; ---------------------------------------------------------------------------
;; Kotoba route: the MC contract over Form. Problems are returned as data while
;; instructions are converted, and the first one aborts `validate!`.
;; ---------------------------------------------------------------------------

#?(:kotoba
   (defn- fget [m [:ref :form/r] k :keyword] [:ref :form/r]
     (form/form-get m (form/keyword-form k))))

#?(:kotoba
   (defn- fhas? [m [:ref :form/r] k :keyword] :bool
     (form/form-has? m (form/keyword-form k))))

#?(:kotoba
   (defn- fkeyset? [m [:ref :form/r] text :string] :bool
     (and (form/is-map? m) (form/eq (form/keys-of m) (form/edn-form text)))))

#?(:kotoba
   (defn- kw-of [f [:ref :form/r]] :keyword
     (if (form/is-keyword? f) (form/keyword-value f) :none)))

#?(:kotoba
   (defn- reject! [problem :keyword] :i64
     (throw (ex-info "MC rejected" {:phase :mc :problem problem}))))

#?(:kotoba
   (defn- problem-of [problem :keyword] [:ref :form/r]
     (form/form-map (form/two-forms (form/keyword-form :problem) (form/keyword-form problem)))))

#?(:kotoba
   (defn- ok-of [value [:ref :form/r]] [:ref :form/r]
     (form/form-map (form/two-forms (form/keyword-form :ok) value))))

#?(:kotoba
   (defn- keyword-text [k :keyword] :string
     (document-edn-print (document-keyword k))))

;; Does the namespace of ENCODING equal the name of TARGET?
#?(:kotoba
   (defn- encoding-matches-target? [target [:ref :form/r] encoding [:ref :form/r]] :bool
     (and (form/is-keyword? target)
          (form/is-keyword? encoding)
          (let [t (keyword-text (form/keyword-value target))
                e (keyword-text (form/keyword-value encoding))
                slash (string-find-byte e 47 0)]
            (and (>= slash 0)
                 (string=? (string-substring e 1 slash)
                           (string-substring t 1 (string-byte-length t))))))))

#?(:kotoba
   (defn- encoding-operation [encoding [:ref :form/r]] :keyword
     (let [e (keyword-text (form/keyword-value encoding))
           slash (string-find-byte e 47 0)]
       (keyword-from-string (string-substring e (+ slash 1) (string-byte-length e))))))

;; INSTRUCTION without the two MC keys, its operation spelled as a MIR op.
#?(:kotoba
   (defn- selected-as-mir [instruction [:ref :form/r] operation :keyword] [:ref :form/r]
     (let [kids (form/kids-of instruction)
           n (vector-count kids)
           rest-map (loop [j 0 acc (form/no-forms)]
                      (if (>= (+ j 1) n) acc
                        (let [k (typed-list-nth [:list [:ref :form/r]] kids j)
                              v (typed-list-nth [:list [:ref :form/r]] kids (+ j 1))]
                          (recur (+ j 2)
                                 (if (or (form/eq k (form/keyword-form :mc/op)) (form/eq k (form/keyword-form :mc/encoding)))
                                   acc
                                   (form/append-form (form/append-form acc k) v))))))]
       (form/assoc-form (form/form-map rest-map) (form/keyword-form :mir/op)
                        (form/keyword-form (keyword-from-string (string-concat "mir/" (let [t (keyword-text operation)] (string-substring t 1 (string-byte-length t))))))))))

#?(:kotoba
   (defn- selected-instruction-result [target [:ref :form/r] instruction [:ref :form/r]] [:ref :form/r]
     (let [encoding (fget instruction :mc/encoding)]
       (if (not (encoding-matches-target? target encoding))
         (problem-of :target-encoding-mismatch)
         (let [operation (encoding-operation encoding)
               text (selected-keyset-text operation)]
           (if (or (string=? text "") (not (fkeyset? instruction text)))
             (problem-of :non-canonical-selected-instruction)
             (ok-of (selected-as-mir instruction operation))))))))

#?(:kotoba
   (defn- two-key-map [k1 :keyword v1 [:ref :form/r] k2 :keyword v2 [:ref :form/r]] [:ref :form/r]
     (form/form-map (form/append-form (form/append-form (form/append-form (form/append-form (form/no-forms) (form/keyword-form k1)) v1) (form/keyword-form k2)) v2))))

#?(:kotoba
   (defn- three-key-map [k1 :keyword v1 [:ref :form/r] k2 :keyword v2 [:ref :form/r] k3 :keyword v3 [:ref :form/r]] [:ref :form/r]
     (form/assoc-form (two-key-map k1 v1 k2 v2) (form/keyword-form k3) v3)))

#?(:kotoba
   (defn- to-mir-instruction-result [target [:ref :form/r] instruction [:ref :form/r]] [:ref :form/r]
     (let [op (kw-of (fget instruction :mc/op))]
       (cond
         (form/eq (fget instruction :mir/op) (form/keyword-form :mir/label)) (ok-of instruction)
         (= op :mc/reentry)
         (if (fkeyset? instruction "#{:mc/op :mc/parameters}")
           (ok-of (two-key-map :mir/op (form/keyword-form :mir/reentry) :mir/parameters (fget instruction :mc/parameters)))
           (problem-of :non-canonical-reentry))
         (= op :mc/recur)
         (if (fkeyset? instruction "#{:mc/op :mc/arguments}")
           (ok-of (two-key-map :mir/op (form/keyword-form :mir/recur) :mir/arguments (fget instruction :mc/arguments)))
           (problem-of :non-canonical-recur))
         (= op :mc/instruction) (selected-instruction-result target instruction)
         (or (= op :mc/branch-zero) (= op :mc/branch-nonzero))
         (if (fkeyset? instruction "#{:mc/op :mc/test :mc/target}")
           (ok-of (three-key-map :mir/op (form/keyword-form (if (= op :mc/branch-zero) :mir/branch-zero :mir/branch-nonzero))
                                 :mir/test (fget instruction :mc/test)
                                 :mir/target (fget instruction :mc/target)))
           (problem-of :non-canonical-branch))
         (= op :mc/jump)
         (if (fkeyset? instruction "#{:mc/op :mc/target}")
           (ok-of (two-key-map :mir/op (form/keyword-form :mir/jump) :mir/target (fget instruction :mc/target)))
           (problem-of :non-canonical-jump))
         :else (problem-of :unknown-operation)))))

;; {:ok mir-instructions} or {:problem kw}
#?(:kotoba
   (defn- convert-instructions [target [:ref :form/r] instructions [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of instructions)]
       (loop [i 0 out (form/no-forms)]
         (if (>= i n)
           (ok-of (form/form-vec out))
           (let [r (to-mir-instruction-result target (form/nth-of instructions i))]
             (if (form/form-has? r (form/keyword-form :problem))
               r
               (recur (inc i) (form/append-form out (form/form-get r (form/keyword-form :ok)))))))))))

#?(:kotoba
   (defn- target-known? [target [:ref :form/r]] :bool
     (or (form/eq target (form/keyword-form :x86-64)) (form/eq target (form/keyword-form :aarch64)))))

#?(:kotoba
   (defn- validate-v2! [program [:ref :form/r]] [:ref :form/r]
     (let [target (fget program :mc/target)
           frame-slots (fget program :mc/frame-slots)
           instructions (fget program :mc/instructions)]
       (if (not (and (fkeyset? program "#{:mc/version :mc/target :mc/frame-slots :mc/instructions}")
                     (form/is-int? (fget program :mc/version))
                     (= 2 (form/int-value (fget program :mc/version)))
                     (target-known? target)
                     (form/is-int? frame-slots)
                     (>= (form/int-value frame-slots) 0)
                     (<= (form/int-value frame-slots) 4095)
                     (form/is-vec? instructions)))
         (do (reject! :non-canonical-program) program)
         (let [r (convert-instructions target instructions)]
           (if (form/form-has? r (form/keyword-form :problem))
             (do (reject! (kw-of (fget r :problem))) program)
             (do (mir/validate!
                  (form/form-map
                   (form/append-form
                    (form/append-form
                     (form/append-form
                      (form/append-form
                       (form/append-form
                        (form/append-form
                         (form/append-form
                          (form/append-form
                           (form/append-form
                            (form/append-form (form/no-forms) (form/keyword-form :mir/version))
                            (form/int-form 1))
                           (form/keyword-form :mir/target))
                          target)
                         (form/keyword-form :mir/registers))
                        (form/keyword-form :physical))
                       (form/keyword-form :mir/frame-slots))
                      frame-slots)
                     (form/keyword-form :mir/instructions))
                    (form/form-get r (form/keyword-form :ok)))))
                 program)))))))

;; A v3 function as a MIR function: {:ok function} or {:problem kw}
#?(:kotoba
   (defn- convert-function [target [:ref :form/r] function [:ref :form/r]] [:ref :form/r]
     (let [instructions (fget function :mc/instructions)]
       (if (not (and (fkeyset? function "#{:mc/name :mc/arity :mc/frame-slots :mc/frame-policy :mc/instructions}")
                     (form/is-vec? instructions)))
         (problem-of :non-canonical-function)
         (let [r (convert-instructions target instructions)]
           (if (form/form-has? r (form/keyword-form :problem))
             r
             (ok-of (mir-function function (form/form-get r (form/keyword-form :ok))))))))))

#?(:kotoba
   (defn- mir-function [function [:ref :form/r] instructions [:ref :form/r]] [:ref :form/r]
     (form/assoc-form
      (form/assoc-form
       (form/assoc-form
        (two-key-map :mir/name (fget function :mc/name) :mir/arity (fget function :mc/arity))
        (form/keyword-form :mir/frame-slots) (fget function :mc/frame-slots))
       (form/keyword-form :mir/frame-policy) (fget function :mc/frame-policy))
      (form/keyword-form :mir/instructions) instructions)))

;; {:ok mir-functions} or {:problem kw}
#?(:kotoba
   (defn- convert-functions [target [:ref :form/r] functions [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of functions)]
       (loop [i 0 out (form/no-forms)]
         (if (>= i n)
           (ok-of (form/form-vec out))
           (let [r (convert-function target (form/nth-of functions i))]
             (if (form/form-has? r (form/keyword-form :problem))
               r
               (recur (inc i) (form/append-form out (form/form-get r (form/keyword-form :ok)))))))))))

#?(:kotoba
   (defn- mir-module [target [:ref :form/r] entry [:ref :form/r] functions [:ref :form/r]] [:ref :form/r]
     (form/assoc-form
      (form/assoc-form
       (form/assoc-form
        (two-key-map :mir/version (form/int-form 3) :mir/target target)
        (form/keyword-form :mir/registers) (form/keyword-form :physical))
       (form/keyword-form :mir/entry) entry)
      (form/keyword-form :mir/functions) functions)))

#?(:kotoba
   (defn- validate-v3! [module [:ref :form/r]] [:ref :form/r]
     (let [target (fget module :mc/target)
           functions (fget module :mc/functions)]
       (if (not (and (fkeyset? module "#{:mc/version :mc/target :mc/entry :mc/functions}")
                     (form/is-int? (fget module :mc/version))
                     (= 3 (form/int-value (fget module :mc/version)))
                     (target-known? target)
                     (form/is-vec? functions)
                     (> (form/count-of functions) 0)))
         (do (reject! :non-canonical-module) module)
         (let [r (convert-functions target functions)]
           (if (form/form-has? r (form/keyword-form :problem))
             (do (reject! (kw-of (fget r :problem))) module)
             (do (mir/validate! (mir-module target (fget module :mc/entry) (form/form-get r (form/keyword-form :ok))))
                 module)))))))

#?(:kotoba
   (defn validate!
     "Validate and return a closed allocated MC program unchanged. v3 mirrors
     physical MIR function/frame ownership while retaining target encodings."
     [program [:ref :form/r]] [:ref :form/r]
     (let [version (fget program :mc/version)]
       (cond
         (and (form/is-int? version) (= 2 (form/int-value version))) (validate-v2! program)
         (and (form/is-int? version) (= 3 (form/int-value version))) (validate-v3! program)
         :else (do (reject! :unsupported-version) program)))))

#?(:kotoba nil :default
(def ^:private operation-keysets
  {:mc/reentry #{:mc/op :mc/parameters}
   :mc/recur #{:mc/op :mc/arguments}
   :mc/branch-zero #{:mc/op :mc/test :mc/target}
   :mc/branch-nonzero #{:mc/op :mc/test :mc/target}
   :mc/jump #{:mc/op :mc/target}}))

#?(:kotoba nil :default
(defn- reject! [problem instruction]
  (throw (ex-info (str "MC rejected: " (name problem))
                  {:phase :mc :problem problem :instruction instruction}))))

#?(:kotoba nil :default
(defn- selected-operation [target instruction]
  (let [encoding (:mc/encoding instruction)]
    (when-not (and (keyword? encoding) (= (name target) (namespace encoding)))
      (reject! :target-encoding-mismatch instruction))
    (let [operation (keyword (name encoding))
          keyset (get selected-keysets operation)]
      (when-not (= keyset (set (keys instruction)))
        (reject! :non-canonical-selected-instruction instruction))
      operation))))

#?(:kotoba nil :default
(defn- ->mir-instruction [target instruction]
  (if (= :mir/label (:mir/op instruction))
    instruction
    (case (:mc/op instruction)
      :mc/reentry
      (do
        (when-not (= (get operation-keysets :mc/reentry) (set (keys instruction)))
          (reject! :non-canonical-reentry instruction))
        {:mir/op :mir/reentry :mir/parameters (:mc/parameters instruction)})

      :mc/recur
      (do
        (when-not (= (get operation-keysets :mc/recur) (set (keys instruction)))
          (reject! :non-canonical-recur instruction))
        {:mir/op :mir/recur :mir/arguments (:mc/arguments instruction)})

      :mc/instruction
      (let [operation (selected-operation target instruction)]
        (-> instruction
            (dissoc :mc/op :mc/encoding)
            (assoc :mir/op (keyword "mir" (name operation)))))

      :mc/branch-zero
      (do
        (when-not (= (get operation-keysets :mc/branch-zero)
                     (set (keys instruction)))
          (reject! :non-canonical-branch instruction))
        {:mir/op :mir/branch-zero :mir/test (:mc/test instruction)
         :mir/target (:mc/target instruction)})

      :mc/branch-nonzero
      (do
        (when-not (= (get operation-keysets :mc/branch-nonzero)
                     (set (keys instruction)))
          (reject! :non-canonical-branch instruction))
        {:mir/op :mir/branch-nonzero :mir/test (:mc/test instruction)
         :mir/target (:mc/target instruction)})

      :mc/jump
      (do
        (when-not (= (get operation-keysets :mc/jump) (set (keys instruction)))
          (reject! :non-canonical-jump instruction))
        {:mir/op :mir/jump :mir/target (:mc/target instruction)})

      (reject! :unknown-operation instruction)))))

#?(:kotoba nil :default
(defn- validate-v2!
  [{:mc/keys [version target frame-slots instructions] :as program}]
  (when-not (and (map? program)
                 (= #{:mc/version :mc/target :mc/frame-slots :mc/instructions}
                    (set (keys program)))
                 (= 2 version)
                 (contains? mir/targets target)
                 (integer? frame-slots)
                 (<= 0 frame-slots 4095)
                 (vector? instructions))
    (reject! :non-canonical-program program))
  (let [mir-instructions (mapv #(->mir-instruction target %) instructions)]
    (mir/validate! {:mir/version 1 :mir/target target :mir/registers :physical
                    :mir/frame-slots frame-slots
                    :mir/instructions mir-instructions}))
  program))

#?(:kotoba nil :default
(defn- validate-v3!
  [{:mc/keys [target entry functions] :as module}]
  (when-not (and (= #{:mc/version :mc/target :mc/entry :mc/functions}
                    (set (keys module)))
                 (= 3 (:mc/version module))
                 (contains? mir/targets target)
                 (vector? functions)
                 (seq functions))
    (reject! :non-canonical-module module))
  (let [mir-functions
        (mapv
         (fn [{:mc/keys [name arity frame-slots frame-policy instructions]
               :as function}]
           (when-not (and (= #{:mc/name :mc/arity :mc/frame-slots
                               :mc/frame-policy :mc/instructions}
                             (set (keys function)))
                          (vector? instructions))
             (reject! :non-canonical-function function))
           {:mir/name name
            :mir/arity arity
            :mir/frame-slots frame-slots
            :mir/frame-policy frame-policy
            :mir/instructions (mapv #(->mir-instruction target %) instructions)})
         functions)]
    (mir/validate! {:mir/version 3
                    :mir/target target
                    :mir/registers :physical
                    :mir/entry entry
                    :mir/functions mir-functions}))
  module))

#?(:kotoba nil :default
(defn validate!
  "Validate and return a closed allocated MC program unchanged. v3 mirrors
  physical MIR function/frame ownership while retaining target encodings."
  [{:mc/keys [version] :as program}]
  (case version
    2 (validate-v2! program)
    3 (validate-v3! program)
    (reject! :unsupported-version program))))
